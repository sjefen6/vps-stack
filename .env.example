# ── Server Identity ─────────────────
# The primary hostname of this VPS (used for Apache, 1Password sync, etc.)
VPS_HOSTNAME=web01.example.com

# Public contact email (visible on error pages, etc.)
VPS_EMAIL_PUBLIC=admin@example.com

# Private contact email (used for Let's Encrypt and backup alerts)
VPS_EMAIL_PRIVATE=alerts@example.com

# The primary IP addresses of this VPS
VPS_IPV4=192.0.2.1
VPS_IPV6=2001:db8::1

# ── Rig Configuration ───────────────
# Enable optional services (e.g. 'production' enables backup/certbot)
COMPOSE_PROFILES=production

# Comma-separated list of core domains tracked by this rig (for check-dns.sh)
VPS_DOMAINS="example.com,example.net,example.org"

# ── 1Password Sync ──────────────────
# The vault where this server's secrets are stored
VPS_VAULT=ServerConfig

# ── Icecast Streaming ───────────────
# Dedicated IP addresses for Icecast
ICECAST_IPV4=192.0.2.2
ICECAST_IPV6=2001:db8::2

# The name of the Let's Encrypt certificate to use for Icecast SSL (e.g. example.com)
ICECAST_CERT_NAME=example.com
