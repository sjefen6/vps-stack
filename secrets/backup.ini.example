# Restic backup configuration
# Copy to backup.ini and fill in real values

[restic]
repository = b2:my-backup-bucket:/vps-stack
password   = a-strong-random-passphrase-store-in-1password

[retention]
keep_daily   = 14
keep_weekly  = 8
keep_monthly = 24
keep_yearly  = 10

[b2]
account_id  = your-b2-account-id
account_key = your-b2-application-key

[notify]
email = youraddress@example.com

[smtp]
user         = youraddress@gmail.com
app_password = xxxx xxxx xxxx xxxx
